            exp text ( locstring( "@" + ( tablelookupbyrow( staticdvarstring( "fo_table" ) , ( getFOGoal( 1 ) ) , 4 )
                    ) , ( int( getFOReward( 1 ) ) ) );
            exp rect H ( 15;
            exp rect W ( 40;
            exp rect Y ( ( ( 1 * 40 ) + 20 + 15 );
            exp rect X ( 5 + 40 + 5 + min( max( ( milliseconds ) - ( 500 / 2 ) + localvarint( "ui_fo_complete_time" )
                    + 1 * 500 ) / 200 , 0 ) , 1 ) * ( 0 - 512 );
        }
    }
}
