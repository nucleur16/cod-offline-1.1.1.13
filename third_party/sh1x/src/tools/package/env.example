# Copy to .env and edit. docker compose reads it automatically.

# The lobby's state directory on this host (its CODOL_STATE_DIR; with the
# lobby's own docker compose this is its ./data). Absolute path.
LOBBY_STATE_DIR=/opt/sh1x-lobby/data

# Game server UDP port. Open it in the firewall, and give the lobby the same
# value as CODOL_MM_HOST_PORT (with CODOL_MM_HOST_IP = this host's public IP).
GAME_PORT=17733

# Map the server boots into before the lobby hands it a match.
START_MAP=mp_rust
START_GAMETYPE=dm
START_ZONE_TYPE=mp

# Bots fill around the real players: none while the server is empty, otherwise
# BOTFILL minus the real players, at most BOTMAX. BOTFILL=0 = a fixed BOTS count.
BOTFILL=12
BOTMAX=11
BOTS=0

# Player slots.
MAXCLIENTS=18

# 1 keeps diagnostic traces in the log; 0 for a quiet production log.
DEVELOPER=0

# Extra +set pairs for the game server, e.g. "+set sv_maxclients 18".
EXTRA_ARGS=

# 1 = only clients the lobby admitted can join, as their lobby account and
# gamertag. Keep 1; 0 only for local debugging.
GAME_ADMISSION_REQUIRED=1
