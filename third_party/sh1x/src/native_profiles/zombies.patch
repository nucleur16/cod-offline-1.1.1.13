+#include "cvar.h"
+#include "server.h"
+#include "qcommon.h"
+#include "sys_main.h"
+#endif
+#include <limits.h>
+
+static struct {
+    int active, slot, seen_arm, arm, server_id, connect_time, challenge;
+    unsigned started, duration_ms, count, previous;
+    int previous_valid;
+} accepted_trace;
+
+/* Strict strings also accept custom `set` dvars; never use type-dependent
+ * integer union reads on arbitrary custom dvars. Values are never written. */
+static int accepted_trace_int(const char *name, int *out)
+{
+    char text[32]; unsigned value=0,i;
+    Cvar_VariableStringBuffer(name,text,sizeof(text));
+    if(!text[0]) return 0;
+    for(i=0;text[i];++i) {
+        unsigned digit=(unsigned)(text[i]-'0');
+        if(digit>9 || value>((unsigned)INT_MAX-digit)/10u) return 0;
+        value=value*10u+digit;
+    }
+    if(i==sizeof(text)-1) return 0; /* cannot distinguish truncated input */
+    *out=(int)value;
+    return 1;
+}
+static void accepted_trace_end(const char *reason)
+{
+    if(accepted_trace.active)
+        ((void)0);
+    accepted_trace.active=0;
+    accepted_trace.previous_valid=0;
+    accepted_trace.previous=0;
+    accepted_trace.slot=-1;
+    accepted_trace.server_id=accepted_trace.connect_time=accepted_trace.challenge=0;
+    accepted_trace.started=accepted_trace.duration_ms=0;
+    /* Retain seen_arm: disconnect/gate loss must not silently rearm a slot. */
+}
+
+void CODOL_AcceptedInputTraceFrameTick(void)
+{
+    char marker[64];
+    int dev=0,slot=-1,arm=0,seconds=0,server_id=0,valid;
+    client_t *owner=0;
+    unsigned now=Sys_Milliseconds();
+    Cvar_VariableStringBuffer("codol_local_test_marker",marker,sizeof(marker));
+    valid=accepted_trace_int("developer",&dev) && dev==1 &&
+        !strcmp(marker,"c1-jump-input-20261020") &&
+        accepted_trace_int("codol_traceAcceptedSlot",&slot) &&
+        slot>=0 && slot<MAX_CLIENTS &&
+        accepted_trace_int("codol_traceAcceptedSeconds",&seconds) &&
+        seconds>=1 && seconds<=30;
+    if(!accepted_trace_int("codol_traceAcceptedArm",&arm) || arm<1) arm=0;
+    if(sv_serverid) server_id=sv_serverid->integer;
+    if(valid && sv_maxclients && slot<sv_maxclients->integer &&
+       com_sv_running && com_sv_running->boolean) {
+        owner=&svs.clients[slot];
+        valid=owner->state>=CS_PRIMED && owner->netchan.remoteAddress.type!=NA_BOT;
+    } else valid=0;
+    if(!valid) {
+        accepted_trace_end("gate_or_owner_lost");
+        accepted_trace.seen_arm=arm;
+        return;
+    }
+    if(accepted_trace.active &&
+       (slot!=accepted_trace.slot || server_id!=accepted_trace.server_id ||
+        owner->lastConnectTime!=accepted_trace.connect_time ||
+        owner->challenge!=accepted_trace.challenge)) {
+        accepted_trace_end("owner_changed");
+        accepted_trace.seen_arm=arm;
+        return;
+    }
+    if(accepted_trace.active && arm!=accepted_trace.arm)
+        accepted_trace_end("disarmed_or_rearmed");
+    if(accepted_trace.active &&
+       now-accepted_trace.started>=accepted_trace.duration_ms)
+        accepted_trace_end("timeout");
+    if(!arm || arm==accepted_trace.seen_arm) return;
+    accepted_trace.seen_arm=arm;
+    accepted_trace.active=1;
+    accepted_trace.arm=arm;
+    accepted_trace.slot=slot;
+    accepted_trace.server_id=server_id;
+    accepted_trace.connect_time=owner->lastConnectTime;
+    accepted_trace.challenge=owner->challenge;
+    accepted_trace.started=now;
+    accepted_trace.duration_ms=(unsigned)seconds*1000u;
+    accepted_trace.count=0;
+    accepted_trace.previous=0;
+    accepted_trace.previous_valid=0;
+    ((void)0);
+}
+
+static void accepted_trace_command(unsigned client,const usercmd_t *native,
+                                   const codol_weapon_input_t *input)
+{
+    unsigned rise=0,fall=0;
+    CODOL_AcceptedInputTraceFrameTick();
+    if(!accepted_trace.active || client!=(unsigned)accepted_trace.slot) return;
+    if(!native || input->kind!=CODOL_INPUT_NETWORK || !input->raw_valid) {
+        accepted_trace_end("non_network_acceptance");
+        return;
+    }
+    if(accepted_trace.previous_valid) {
+        rise=input->raw.buttons & ~accepted_trace.previous;
+        fall=accepted_trace.previous & ~input->raw.buttons;
+    }
+    ++accepted_trace.count;
+    ((void)0);
+    accepted_trace.previous=input->raw.buttons;
+    accepted_trace.previous_valid=1;
+    if(accepted_trace.count>=8192u) accepted_trace_end("capped_incomplete");
+}
+static void accepted_trace_reset(unsigned client)
+{
+    int slot=-1,arm=0;
+    if(accepted_trace.active && client==(unsigned)accepted_trace.slot)
+        accepted_trace_end("client_or_game_reset");
+    /* Consume even a not-yet-polled arm for this resetting slot: an operator
+     * setting the arm immediately before disconnect must not arm its reuse. */
+    if(accepted_trace_int("codol_traceAcceptedSlot",&slot) && slot>=0 &&
+       client==(unsigned)slot) {
+        if(!accepted_trace_int("codol_traceAcceptedArm",&arm) || arm<1) arm=0;
+        accepted_trace.seen_arm=arm;
+    }
+}
+#endif
