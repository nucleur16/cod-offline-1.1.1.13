@@ -0,0 +1,36 @@
+/* SPDX-License-Identifier: AGPL-3.0-or-later */
+#ifdef CODOL_SERVER
+#include "codol_script_centroid.h"
+#include "scr_vm_functions.h"
+#include "entity.h"
+
+/* Entity getCentroid() -> vector. T5's Thundergun needs a live body center,
+ * not the origin at an actor's feet. Adapt to the C1 actor geometry already
+ * used by CODOL_ActorCanSee/Actor melee targeting: currentOrigin plus the
+ * midpoint of entityShared mins/maxs (entity.h, retained offsets108/114).
+ * This is the server collision center, not an animated model centroid. No
+ * state is cached: stance/bounds updates and entity-slot reuse apply now. */
+void CODOL_Scr_GetCentroid(scr_entref_t ref)
+{
+    gentity_t *entity;
+    vec3_t center;
+    int i;
+    if (Scr_GetNumParam() != 0) {
+        Scr_Error("Usage: entity getCentroid()");
+        return;
+    }
+    if (ref.classnum || ref.entnum >= MAX_GENTITIES) {
+        Scr_ObjectError("not an entity");
+        return;
+    }
+    entity = &g_entities[ref.entnum];
+    if (!entity->r.inuse) {
+        Scr_ObjectError("entity is not in use");
+        return;
+    }
+    for (i = 0; i < 3; ++i)
+        center[i] = entity->r.currentOrigin[i] +
+            (entity->r.mins[i] + entity->r.maxs[i]) * 0.5f;
+    Scr_AddVector(center);
+}
+#endif
