+/* A roster admission is not a playback rewind. C1 has a global timestamp
+ * watermark, so keep the undelivered old commands in time order before the
+ * newcomers' current-time pose; never restamp or rebootstrap survivors. */
+static int carry_visible(codol_actor_anim_event_t *out,unsigned *count,
+                         const codol_actor_anim_event_t *event,
+                         codol_actor_anim_visible_t visible,void *context)
+{
+    int present=visible(event->command.entity,event->generation,context);
+    if(present!=0 && present!=1)return FAIL("roster carry: invalid visibility result");
+    if(!present)return 1;
+    if(*count>=CODOL_ACTOR_ANIM_SNAPSHOT_LIMIT)return FAIL("roster carry: command capacity exceeded");
+    out[(*count)++]=*event;return 1;
+}
+static int carry_previous(const client_delivery_t *state,uint32_t ackSequence,
+    const codol_actor_anim_cut_t *cut,codol_actor_anim_visible_t visible,void *context,
+    codol_actor_anim_event_t *out,unsigned *count)
+{
+    const delivery_t *ack=&state->history[ackSequence%DELIVERY_HISTORY];
+    uint64_t start,serial;unsigned i;
+    if(!state->initialized || state->epoch!=mapEpoch ||
+       cut->time<state->bootstrapCut.time || cut->end<state->bootstrapCut.end)
+        return FAIL("roster carry: no forward prior timeline");
+    if(ack->valid && ack->sequence==ackSequence && ack->timeline==state->timeline &&
+       ack->cut.epoch==mapEpoch && ack->cut.end<=cut->end && ack->cut.time<=cut->time)
+        start=ack->cut.end;
+    else {
+        start=state->bootstrapCut.end;
+        for(i=0;i<state->bootstrapCount;++i)
+            if(!carry_visible(out,count,state->bootstrap+i,visible,context))return 0;
+    }
