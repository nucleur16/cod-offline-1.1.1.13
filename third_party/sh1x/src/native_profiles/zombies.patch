diff --git a/zombies/src/codol/snapshot/codol_snapshot_schedule.c b/src/codol/snapshot/codol_snapshot_schedule.c
new file mode 100644
index 0000000..1972309
--- /dev/null
+++ b/src/codol/snapshot/codol_snapshot_schedule.c
@@ -0,0 +1,56 @@
+#include "codol_snapshot_schedule.h"
+#include <stdlib.h>
+#include <errno.h>
+#include <limits.h>
+
+int CODOL_SnapshotSelectFps(int simulationFps, int defaultFps, const char *snaps)
+{
+    char *end;
+    long requested;
+    int fps;
+    if (simulationFps < 1) simulationFps = 1;
+    if (simulationFps > 250) simulationFps = 250;
+    fps = defaultFps;
+    if (fps < 1) fps = 1;
+    if (fps > simulationFps) fps = simulationFps;
+    if (!snaps || !*snaps) return fps;
+    errno = 0;
+    requested = strtol(snaps, &end, 10);
+    if (errno || end == snaps || *end || requested <= 0) return fps;
+    /* Preserve explicit client's original 10..simulation ceiling. */
+    if (requested < 10) requested = 10;
+    if (requested > simulationFps) requested = simulationFps;
+    return (int)requested;
+}
+
+int CODOL_SnapshotConfigure(codol_snapshot_schedule_t *clock, int now, int fps)
+{
+    int changed;
+    if (fps < 1) fps = 1;
+    if (fps > 250) fps = 250;
+    changed = !clock->initialized || clock->fps != fps || now < clock->lastTime;
+    if (changed) {
+        clock->nextUsec = (int64_t)now * 1000;
+        clock->fps = fps;
+        clock->initialized = 1;
+    }
+    clock->lastTime = now;
+    return changed;
+}
+
+int CODOL_SnapshotSent(codol_snapshot_schedule_t *clock, int now, int rateMsec)
+{
+    int64_t nowUsec = (int64_t)now * 1000;
+    int64_t period = 1000000 / clock->fps;
+    int64_t deadline, rateDeadline;
+    /* Advance from the old deadline, skipping all missed slots after a hitch.
+     * Advancing from now would quantize 30 Hz to 50 ms on a 60 Hz frame loop. */
+    /* svs.time exposes whole milliseconds. Match its precision so a 60-Hz
+     * request does not miss its 16-ms frame waiting for a 17-ms deadline. */
+    if (clock->nextUsec / 1000 <= now)
+        clock->nextUsec += ((nowUsec + 999 - clock->nextUsec) / period + 1) * period;
+    deadline = clock->nextUsec / 1000;
+    rateDeadline = (int64_t)now + (rateMsec > 0 ? rateMsec : 0);
+    if (rateDeadline > deadline) deadline = rateDeadline;
+    return deadline > INT_MAX ? INT_MAX : (int)deadline;
+}
