+/* Local Endless prototype contracts. SPDX-License-Identifier: AGPL-3.0-or-later */
+#ifndef CODOL_ZOMBIES_MODE_H
+#define CODOL_ZOMBIES_MODE_H
+#include <string.h>
+
+/* Existing non-Zombies difficulty domains remain independent. Map admission
+ * rejects a Zombies Endless request unless the operator explicitly opts in. */
+static inline int CODOL_ZombiesModeAllowed(const char *zone, const char *map,
+                                         int difficulty, const char *enabled)
+{
+    return !zone || strcmp(zone, "zm") || difficulty != 3 ||
+           (enabled && !strcmp(enabled, "1") && map &&
+            (!strcmp(map,"zm_prototype_sh") || !strcmp(map,"zm_asylum_sh")));
+}
+
+/* Endless is a mode, not a Veteran reward tier. Preserve explicit operator
+ * league overrides in the caller; this changes only its default. */
+static inline int CODOL_ZombiesDefaultLeague(const char *zone, int difficulty)
+{
+    return zone && !strcmp(zone, "zm") && difficulty == 3 ? 1 : difficulty;
+}
+#endif
