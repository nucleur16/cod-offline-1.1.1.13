+
+/* Absolute C1 snapshot deadlines, independent of the simulation clock.
+ * Kept engine-independent for the sender policy fixture. */
+typedef struct codol_snapshot_schedule_s {
+    int64_t nextUsec;
+    int lastTime, fps, initialized;
+} codol_snapshot_schedule_t;
+int CODOL_SnapshotSelectFps(int simulationFps, int defaultFps, const char *snaps);
+int CODOL_SnapshotConfigure(codol_snapshot_schedule_t *clock, int now, int fps);
+int CODOL_SnapshotSent(codol_snapshot_schedule_t *clock, int now, int rateMsec);
