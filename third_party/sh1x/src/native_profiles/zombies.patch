diff --git a/zombies/src/codol/script/codol_localtest.c b/src/codol/script/codol_localtest.c
new file mode 100644
index 0000000..de91d1d
--- /dev/null
+++ b/src/codol/script/codol_localtest.c
@@ -0,0 +1,259 @@
+/* Local developer capability; no client command can change the build or environment.
+ * SPDX-License-Identifier: AGPL-3.0-or-later */
+#ifdef CODOL_SERVER
+#include "codol_localtest.h"
+#include "cvar.h"
+#include "scr_vm.h"
+#include "scr_vm_functions.h"
+#include "server.h"
+#include "entity.h"
+#include "g_shared.h"
+#include "codol_localtest_input.h"
+#include <stdlib.h>
+#include <stddef.h>
+
+/* Cmd_Noclip_f / Cmd_UFO_f set these native fields; ClientEndFrame reads
+ * them into C1 pm_type 2/3, and G_SetClientContents disables collision.
+ * CODOL_PM_FreeMoveC1 follows C1 0x410bc0 / 0x410de0 and consumes those modes;
+ * CODOL engine-state publication copies pm_type directly into the C1 wire PS.
+ * Do not use the console commands: their CheatsOk policy is unrelated. */
+_Static_assert(offsetof(gclient_t, noclip) == 0x3078, "native noclip ABI");
+_Static_assert(offsetof(gclient_t, ufo) == 0x307c, "native UFO ABI");
+
+int CODOL_LocalTestBuild(void)
+{
+#ifdef CODOL_LOCAL_TEST_BUILD
+    /* Kept in the ELF for package/promotion rejection before any remote operation. */
+    static volatile const char marker[] = "CODOL_LOCAL_TEST_ONLY_V1";
+    return marker[0] == 'C';
+#else
+    return 0;
+#endif
+}
+
+int CODOL_LocalTestAllowed(void)
+{
+#ifdef CODOL_LOCAL_TEST_BUILD
+    char enabled[32], zone[32], gametype[32];
+    const cvar_t *dedicated = Cvar_FindVar("dedicated");
+    if (!CODOL_LocalTestBuild()) return 0;
+    Cvar_VariableStringBuffer("codol_localTesting", enabled, sizeof(enabled));
+    Cvar_VariableStringBuffer("codol_zoneType", zone, sizeof(zone));
+    Cvar_VariableStringBuffer("g_gametype", gametype, sizeof(gametype));
+    /* dedicated is a CVAR_INIT enum. Cvar_GetInt excludes CVAR_ENUM;
+     * the engine consumes dedicated->integer itself (common.c Com_Frame).
+     * Display text is "dedicated internet server", not the argument "2". */
+    return CODOL_LocalTestPolicy(getenv("CODOL_LOCAL_TEST"), enabled, zone, gametype,
+                                dedicated && dedicated->type == CVAR_ENUM && dedicated->integer == 2 ? "2" : "");
+#else
+    return 0;
+#endif
+}
+
+void CODOL_Scr_LocalTestAllowed(void)
+{
+    Scr_AddBool(CODOL_LocalTestAllowed());
+}
+
+#ifdef CODOL_LOCAL_TEST_BUILD
+static struct {
+    codol_localtest_input_t input;
+    int initialized, generation, server_id;
+} menu_input[MAX_CLIENTS];
+
+static struct {
+    gclient_t *client;
+    int mode, generation, server_id;
+} menu_movement[MAX_CLIENTS];
+
+static int local_movement_matches(unsigned slot, const gentity_t *ent)
+{
+    return slot < MAX_CLIENTS && menu_movement[slot].mode && ent &&
+        ent->client && menu_movement[slot].client == ent->client &&
+        menu_movement[slot].generation == ent->useCount &&
+        menu_movement[slot].server_id == (sv_serverid ? sv_serverid->integer : 0);
+}
+
+static int local_movement_flags_match(unsigned slot, const gentity_t *ent)
+{
+    return local_movement_matches(slot, ent) &&
+        !!ent->client->noclip == (menu_movement[slot].mode == 2) &&
+        !!ent->client->ufo == (menu_movement[slot].mode == 3);
+}
+
+static int local_movement_eligible(const gentity_t *ent)
+{
+    return ent && ent->r.inuse && ent->client && ent->health > 0 &&
+        ent->client->sess.sessionState == SESS_STATE_PLAYING &&
+        !ent->client->lastStand && !ent->tagInfo &&
+        (ent->client->ps.pm_type == 0 || ent->client->ps.pm_type == 2 ||
+         ent->client->ps.pm_type == 3);
+}
+
+static void local_movement_reset(unsigned slot, gentity_t *ent)
+{
+    if (slot >= MAX_CLIENTS) return;
+    /* Only tear down fields this capability still owns. ClientSpawn clears
+     * gclient itself; a new entity/server or a foreign mode must not inherit
+     * stale bookkeeping or have its movement fields overwritten. */
+    if (local_movement_flags_match(slot, ent)) {
+        ent->client->noclip = ent->client->ufo = qfalse;
+        VectorClear(ent->client->ps.velocity);
+        if (ent->client->ps.pm_type == 2 || ent->client->ps.pm_type == 3)
+            ent->client->ps.pm_type = ent->client->lastStand ? 7 :
+                ent->client->sess.sessionState == SESS_STATE_DEAD ?
+                (ent->tagInfo ? 9 : 8) : (ent->tagInfo ? 1 : 0);
+        G_SetClientContents(ent);
+    }
+    memset(&menu_movement[slot], 0, sizeof(menu_movement[slot]));
+}
+
+static gentity_t *local_movement_entity(scr_entref_t object)
+{
+    gentity_t *ent;
+    if (object.classnum || object.entnum >= MAX_CLIENTS) {
+        Scr_ObjectError("not a player\n");
+        return NULL;
+    }
+    ent = &g_entities[object.entnum];
+    if (!ent->r.inuse || !ent->client || svs.clients[object.entnum].gentity != ent) {
+        Scr_ObjectError("not a connected player\n");
+        return NULL;
+    }
+    return ent;
+}
+
+static int local_input_client(unsigned client)
+{
+    gentity_t *ent;
+    int server_id = sv_serverid ? sv_serverid->integer : 0;
+    if (client >= MAX_CLIENTS) return 0;
+    ent = svs.clients[client].gentity;
+    if (!CODOL_LocalTestAllowed() || !ent || !ent->r.inuse || !ent->client) {
+        CODOL_LocalTestResetInput(client);
+        return 0;
+    }
+    if (!menu_input[client].initialized || menu_input[client].generation != ent->useCount ||
+        menu_input[client].server_id != server_id) {
+        CODOL_LocalTestInputReset(&menu_input[client].input);
+        menu_input[client].initialized = 1;
+        menu_input[client].generation = ent->useCount;
+        menu_input[client].server_id = server_id;
+    }
+    return 1;
+}
+#endif
+
+void CODOL_LocalTestResetInput(unsigned client)
+{
+#ifdef CODOL_LOCAL_TEST_BUILD
+    if (client < MAX_CLIENTS) {
+        local_movement_reset(client, svs.clients[client].gentity);
+        memset(&menu_input[client], 0, sizeof(menu_input[client]));
+    }
+#else
+    (void)client;
+#endif
+}
+
+void CODOL_LocalTestClientEndFrame(gentity_t *ent)
+{
+#ifdef CODOL_LOCAL_TEST_BUILD
+    unsigned slot;
+    if (!ent || (unsigned)ent->s.number >= MAX_CLIENTS) return;
+    slot = (unsigned)ent->s.number;
+    if (!menu_movement[slot].mode) return;
+    if (!local_movement_flags_match(slot, ent) || !CODOL_LocalTestAllowed() ||
+        !local_movement_eligible(ent))
+        local_movement_reset(slot, ent);
+#else
+    (void)ent;
+#endif
+}
+
+void CODOL_Player_LocalTestMovement(scr_entref_t object)
+{
+    int mode;
+    if (Scr_GetNumParam() != 1 ||
+        (mode = CODOL_LocalTestMovementValue(Scr_GetString(0))) < 0) {
+        Scr_Error("Usage: <player> codolLocalTestMovement(\"normal\"|\"noclip\"|\"ufo\")\n");
+        return;
+    }
+#ifdef CODOL_LOCAL_TEST_BUILD
+    gentity_t *ent = local_movement_entity(object);
+    unsigned slot = object.entnum;
+    if (!ent) return;
+    CODOL_LocalTestClientEndFrame(ent);
+    /* The no-capability path deliberately retains safe owned-state teardown. */
+    if (!mode) {
+        local_movement_reset(slot, ent);
+        Scr_AddBool(1);
+        return;
+    }
+    if (!CODOL_LocalTestAllowed() || !local_movement_eligible(ent)) {
+        Scr_AddBool(0);
+        return;
+    }
+    menu_movement[slot].client = ent->client;
+    menu_movement[slot].mode = mode;
+    menu_movement[slot].generation = ent->useCount;
+    menu_movement[slot].server_id = sv_serverid ? sv_serverid->integer : 0;
+    ent->client->noclip = mode == 2;
+    ent->client->ufo = mode == 3;
+    ent->client->ps.pm_type = mode;
+    VectorClear(ent->client->ps.velocity);
+    G_SetClientContents(ent);
+    Scr_AddBool(1);
+#else
+    (void)object; (void)mode;
+    Scr_AddBool(0);
+#endif
+}
+
+void CODOL_Player_LocalTestMovementMode(scr_entref_t object)
+{
+    if (Scr_GetNumParam()) {
+        Scr_Error("Usage: <player> codolLocalTestMovementMode()\n");
+        return;
+    }
+#ifdef CODOL_LOCAL_TEST_BUILD
+    gentity_t *ent = local_movement_entity(object);
+    if (!ent) return;
+    CODOL_LocalTestClientEndFrame(ent);
+    Scr_AddString(menu_movement[object.entnum].mode == 2 ? "noclip" :
+                  menu_movement[object.entnum].mode == 3 ? "ufo" : "normal");
+#else
+    (void)object;
+    Scr_AddString("normal");
+#endif
+}
+
+void CODOL_LocalTestObserveInput(unsigned client, unsigned buttons)
+{
+#ifdef CODOL_LOCAL_TEST_BUILD
+    if (local_input_client(client))
+        CODOL_LocalTestInputObserve(&menu_input[client].input, buttons, svs.time);
+#else
+    (void)client; (void)buttons;
+#endif
+}
+
+void CODOL_Player_LocalTestMenuPressed(scr_entref_t object)
+{
+    if (Scr_GetNumParam()) {
+        Scr_Error("Usage: <player> codolLocalTestMenuPressed()\n");
+        return;
+    }
+#ifdef CODOL_LOCAL_TEST_BUILD
+    client_t *client = VM_GetClientForEntRef(object);
+    unsigned slot;
+    if (!client) { Scr_ObjectError("not a client\n"); return; }
+    slot = (unsigned)(client - svs.clients);
+    Scr_AddBool(local_input_client(slot) &&
+        CODOL_LocalTestInputConsume(&menu_input[slot].input, svs.time));
+#else
+    (void)object;
+    Scr_AddBool(0);
+#endif
+}
+#endif
diff --git a/zombies/src/codol/script/codol_localtest.h b/src/codol/script/codol_localtest.h
new file mode 100644
index 0000000..18c2db3
--- /dev/null
+++ b/src/codol/script/codol_localtest.h
@@ -0,0 +1,36 @@
+/* Local developer capability; production builds cannot enable it.
+ * SPDX-License-Identifier: AGPL-3.0-or-later */
+#ifndef CODOL_LOCALTEST_H
+#define CODOL_LOCALTEST_H
+#include <string.h>
+
+static inline int CODOL_LocalTestPolicy(const char *environment, const char *enabled,
+                                      const char *zone, const char *gametype,
+                                      const char *dedicated)
+{
+#ifdef CODOL_LOCAL_TEST_BUILD
+    return environment && !strcmp(environment, "1") && enabled && !strcmp(enabled, "1") &&
+           zone && !strcmp(zone, "zm") && gametype && !strcmp(gametype, "zm") &&
+           dedicated && !strcmp(dedicated, "2");
+#else
+    (void)environment; (void)enabled; (void)zone; (void)gametype; (void)dedicated;
+    return 0;
+#endif
+}
+int CODOL_LocalTestAllowed(void);
+int CODOL_LocalTestBuild(void);
+/* C1/retained native pm_type values. Deliberately no permissive numeric API. */
+static inline int CODOL_LocalTestMovementValue(const char *mode)
+{
+    if (!mode) return -1;
+    if (!strcmp(mode, "normal")) return 0;
+    if (!strcmp(mode, "noclip")) return 2;
+    if (!strcmp(mode, "ufo")) return 3;
+    return -1;
+}
+void CODOL_Scr_LocalTestAllowed(void);
+void CODOL_LocalTestObserveInput(unsigned client, unsigned buttons);
+void CODOL_LocalTestResetInput(unsigned client);
+struct gentity_s;
+void CODOL_LocalTestClientEndFrame(struct gentity_s *entity);
+#endif
diff --git a/zombies/src/codol/script/codol_localtest_input.h b/src/codol/script/codol_localtest_input.h
new file mode 100644
index 0000000..1e391cd
--- /dev/null
+++ b/src/codol/script/codol_localtest_input.h
@@ -0,0 +1,46 @@
+/* Local menu input retained at accepted usercmds, before script polling.
+ * SPDX-License-Identifier: AGPL-3.0-or-later */
+#ifndef CODOL_LOCALTEST_INPUT_H
+#define CODOL_LOCALTEST_INPUT_H
+#include <string.h>
+
+/* C1/native command masks: ADS mode 0x800, melee 4 (player.h and the
+ * retained PlayerCmd_adsButtonPressed/PlayerCmd_meleeButtonPressed readers). */
+typedef struct {
+    unsigned previous;
+    int aim_time, melee_time, pending_time;
+    int blocked, pending;
+} codol_localtest_input_t;
+
+static inline void CODOL_LocalTestInputReset(codol_localtest_input_t *input)
+{
+    memset(input, 0, sizeof(*input));
+    input->aim_time = input->melee_time = -1000;
+}
+
+static inline void CODOL_LocalTestInputObserve(codol_localtest_input_t *input,
+                                              unsigned buttons, int now)
+{
+    int aim = (buttons & 0x800u) != 0, melee = (buttons & 4u) != 0;
+    int aim_edge = aim && !(input->previous & 0x800u);
+    int melee_edge = melee && !(input->previous & 4u);
+    if (aim) input->aim_time = now;
+    if (melee) input->melee_time = now;
+    if (!input->blocked &&
+        ((melee_edge && (aim || (unsigned)now - (unsigned)input->aim_time <= 200u)) ||
+         (aim_edge && (melee || (unsigned)now - (unsigned)input->melee_time <= 200u)))) {
+        input->pending = 1;
+        input->pending_time = now;
+        input->blocked = 1;
+    }
+    if (!aim && !melee) input->blocked = 0;
+    input->previous = buttons;
+}
+
+static inline int CODOL_LocalTestInputConsume(codol_localtest_input_t *input, int now)
+{
+    int pressed = input->pending && (unsigned)now - (unsigned)input->pending_time <= 250u;
+    input->pending = 0;
+    return pressed;
+}
+#endif
