diff --git a/zombies/src/codol/player/codol_revive_token.c b/src/codol/player/codol_revive_token.c
new file mode 100644
index 0000000..85a2b83
--- /dev/null
+++ b/src/codol/player/codol_revive_token.c
@@ -0,0 +1,202 @@
+#ifdef CODOL_SERVER
+#include "codol_persistent_runtime.h"
+#endif
+/* The lobby is the authority for paid Zombies revive tokens. Only its
+ * password-protected local RCON receipt can complete an armed down. */
+#ifdef CODOL_SERVER
+#include "codol_revive_token.h"
+#include "codol_connect.h"
+#include "codol_configstrings.h"
+#include "codol_profile.h"
+#include "codol_script_laststand.h"
+#include "server.h"
+#include "g_shared.h"
+#include "cmd.h"
+#include "scr_vm_functions.h"
+#include "cscr_stringlist.h"
+#include "qcommon_io.h"
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+typedef struct {
+    uint64_t uid;
+    int count;
+    int armed_at;
+    int armed;
+    int spend_requested;
+    uint64_t recent_receipts[8];
+    unsigned next_receipt;
+} codol_token_client_t;
+static codol_token_client_t token_clients[CODOL_MAX_GAME_CLIENTS];
+
+static int hex16(const char *s,uint64_t *out)
+{
+    uint64_t value=0;
+    unsigned i;
+    if(!s || strlen(s)!=16 || !out)return 0;
+    for(i=0;i<16;++i) {
+        unsigned c=(unsigned char)s[i], digit;
+        if(c>='0' && c<='9')digit=c-'0';
+        else if(c>='a' && c<='f')digit=c-'a'+10;
+        else return 0;
+        value=(value<<4)|digit;
+    }
+    if(!value)return 0;
+    *out=value;
+    return 1;
+}
+
+void CODOL_ResetReviveTokenClient(unsigned client)
+{
+    if(client<CODOL_MAX_GAME_CLIENTS)
+        memset(&token_clients[client],0,sizeof(token_clients[client]));
+}
+
+static int active_uid(unsigned slot,uint64_t uid)
+{
+    uint64_t secure_uid=0;
+    return uid && slot<CODOL_MAX_GAME_CLIENTS && sv_maxclients &&
+        slot<(unsigned)sv_maxclients->integer &&
+        svs.clients[slot].state==CS_ACTIVE &&
+        svs.clients[slot].netchan.remoteAddress.type!=NA_BOT &&
+        g_entities[slot].client && g_entities[slot].r.inuse &&
+        CODOL_ClientConnectIdentity(slot)==uid &&
+        CODOL_ClientSecureProfile(slot,&secure_uid) && secure_uid==uid;
+}
+
+static int player_slot(scr_entref_t ref)
+{
+    if(ref.classnum || ref.entnum>=CODOL_MAX_GAME_CLIENTS ||
+       !g_entities[ref.entnum].client) {
+        Scr_ObjectError("Revive token requires a player");
+        return -1;
+    }
+    return ref.entnum;
+}
+
+void CODOL_Scr_GetReviveTokenCount(scr_entref_t ref)
+{
+    int slot=player_slot(ref);
+    uint64_t uid;
+    if(slot<0)return;
+    uid=CODOL_ClientConnectIdentity((unsigned)slot);
+    Scr_AddInt(active_uid((unsigned)slot,uid) && token_clients[slot].uid==uid ?
+        token_clients[slot].count : 0);
+}
+
+void CODOL_Scr_ArmReviveToken(scr_entref_t ref)
+{
+    int slot=player_slot(ref);
+    uint64_t uid;
+    codol_token_client_t *state;
+    if(slot<0)return;
+    uid=CODOL_ClientConnectIdentity((unsigned)slot);
+    if(!active_uid((unsigned)slot,uid) || !CODOL_LastStand_IsActive(&g_entities[slot]) ||
+       g_entities[slot].health<=0) { Scr_AddInt(0); return; }
+    state=&token_clients[slot];
+    if(state->uid!=uid) {
+        memset(state,0,sizeof(*state));
+        state->uid=uid;
+    }
+    state->armed_at=level.time;
+    state->armed=1;
+    state->spend_requested=0;
+    Scr_AddInt(1);
+}
+
+void CODOL_Scr_RequestReviveTokenSpend(scr_entref_t ref)
+{
+    int slot=player_slot(ref);
+    codol_token_client_t *state;
+    uint64_t uid;
+    if(slot<0)return;
+    state=&token_clients[slot];
+    uid=CODOL_ClientConnectIdentity((unsigned)slot);
+    if(!active_uid((unsigned)slot,uid) || !CODOL_LastStand_IsActive(&g_entities[slot]) ||
+       g_entities[slot].health<=0 || state->uid!=uid || !state->armed ||
+       state->spend_requested || level.time<state->armed_at ||
+       level.time-state->armed_at>60000) {
+        Scr_AddInt(0);
+        return;
+    }
+    state->spend_requested=1;
+    SV_GameSendServerCommand(slot,1,"9 consume token");
+    Scr_AddInt(1);
+}
+
+void CODOL_Scr_ClearReviveToken(scr_entref_t ref)
+{
+    int slot=player_slot(ref);
+    if(slot>=0) {
+        token_clients[slot].armed=0;
+        token_clients[slot].spend_requested=0;
+    }
+}
+
+void CODOL_TokenInventory_f(void)
+{
+    uint64_t uid;
+    char *end;
+    long count;
+    int slot;
+    if(Cmd_Argc()!=3 || !hex16(Cmd_Argv(1),&uid))return;
+    count=strtol(Cmd_Argv(2),&end,10);
+    if(*end || count<0 || count>100000)return;
+    for(slot=0;sv_maxclients && slot<sv_maxclients->integer &&
+        slot<CODOL_MAX_GAME_CLIENTS;++slot)if(active_uid((unsigned)slot,uid)) {
+        codol_token_client_t *state=&token_clients[slot];
+        if(state->uid!=uid) {
+            memset(state,0,sizeof(*state));
+            state->uid=uid;
+        }
+        state->count=(int)count;
+    }
+}
+
+void CODOL_TokenConsumed_f(void)
+{
+    uint64_t uid,receipt;
+    int slot;
+    if(Cmd_Argc()!=3 || !hex16(Cmd_Argv(1),&uid) ||
+       !hex16(Cmd_Argv(2),&receipt))return;
+    if(!com_sv_running || !com_sv_running->integer || sv.state!=SS_GAME)goto rejected;
+    for(slot=0;sv_maxclients && slot<sv_maxclients->integer &&
+        slot<CODOL_MAX_GAME_CLIENTS;++slot)if(active_uid((unsigned)slot,uid)) {
+        codol_token_client_t *state=&token_clients[slot];
+        unsigned i,notify;
+        /* The lobby retries a receipt after an RCON reply is lost. A repeat
+         * must acknowledge the original acceptance without a second revive. */
+        if(state->uid==uid)
+            for(i=0;i<8;++i)if(state->recent_receipts[i]==receipt)goto accepted;
+        if(!CODOL_LastStand_IsActive(&g_entities[slot]) || g_entities[slot].health<=0 ||
+           state->uid!=uid || !state->armed || !state->spend_requested ||
+           level.time<state->armed_at ||
+           level.time-state->armed_at>60000)goto rejected;
+        state->recent_receipts[state->next_receipt++%8]=receipt;
+        state->armed=0; /* clear before script callbacks can run */
+        state->spend_requested=0;
+        if(state->count>0)--state->count;
+        notify=SL_GetString("revive_token_consumed",0);
+        Scr_Notify(&g_entities[slot],notify,0);
+        SL_RemoveRefToString(notify);
+        goto accepted;
+    }
+rejected:
+    Com_Printf(CON_CHANNEL_DONT_FILTER,"codol_token_result %s rejected\n",Cmd_Argv(2));
+    return;
+accepted:
+    Com_Printf(CON_CHANNEL_DONT_FILTER,"codol_token_result %s accepted\n",Cmd_Argv(2));
+}
+#endif
+
+#ifdef CODOL_SERVER
+#include "codol_persistent_entities.h"
+static int resident_entity_zero(const void *data,size_t bytes) {
+    const unsigned char *p=(const unsigned char*)data;
+    for(size_t i=0;i<bytes;++i)if(p[i])return 0;
+    return 1;
+}
+
+int CODOL_PersistentReviveTokensEmpty(void){return resident_entity_zero(token_clients,sizeof(token_clients));}
+#endif
