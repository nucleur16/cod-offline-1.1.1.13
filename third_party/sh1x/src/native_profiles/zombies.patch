+    const char *wanted,*displaced; unsigned slot,i,ref;
+    size_t start,end;
+    char rewritten[1024];
+    if(!bank || !base || bank==base || !pinned || !effect || effect>=CODOL_EFFECT_SLOTS) return -1;
+    wanted=CODOL_GetEffectiveConfigstring(bank,base,CODOL_CS_EFFECTS+effect);
+    if(!wanted || !*wanted || strlen(wanted)>=64) return -1;
+    if(effect<CODOL_BYTE_EFFECT_SLOTS) return (int)effect;
+    memcpy(protected,pinned,sizeof(protected)); protected[0]=1;
+    /* Constants can hold numeric selectors without a native binding. */
+    for(i=0;i<CODOL_TAGGED_EFFECT_SLOTS+CODOL_TEAM_THERMAL_SLOTS;++i) {
+        unsigned index=i<CODOL_TAGGED_EFFECT_SLOTS ? CODOL_CS_TAGGED_EFFECTS+i :
+            CODOL_CS_TEAM_THERMAL+i-CODOL_TAGGED_EFFECT_SLOTS;
+        ref=effect_prefix(CODOL_GetEffectiveConfigstring(bank,base,index));
+        if(ref<CODOL_BYTE_EFFECT_SLOTS) protected[ref]=1;
+    }
+    for(i=0;i<CODOL_NOTETRACK_EFFECT_SLOTS;++i) {
+        ref=notetrack_effect(CODOL_GetEffectiveConfigstring(bank,base,CODOL_CS_NOTETRACK_EFFECTS+i),&start,&end);
+        if(ref<CODOL_BYTE_EFFECT_SLOTS) protected[ref]=1;
+    }
+    for(slot=1;slot<CODOL_BYTE_EFFECT_SLOTS;++slot) if(!protected[slot]) break;
+    if(slot==CODOL_BYTE_EFFECT_SLOTS) return -1;
+    displaced=CODOL_GetEffectiveConfigstring(bank,base,CODOL_CS_EFFECTS+slot);
+    for(i=0;i<CODOL_MAX_CONFIGSTRINGS;++i)
+        if(bank->values[i] && !CODOL_SetConfigstring(&candidate,i,bank->values[i])) goto fail;
+    if(!CODOL_SetConfigstring(&candidate,CODOL_CS_EFFECTS+slot,wanted) ||
+       !CODOL_SetConfigstring(&candidate,CODOL_CS_EFFECTS+effect,displaced ? displaced : "")) goto fail;
+    for(i=0;i<CODOL_TAGGED_EFFECT_SLOTS+CODOL_TEAM_THERMAL_SLOTS;++i) {
+        unsigned index=i<CODOL_TAGGED_EFFECT_SLOTS ? CODOL_CS_TAGGED_EFFECTS+i :
+            CODOL_CS_TEAM_THERMAL+i-CODOL_TAGGED_EFFECT_SLOTS;
+        const char *value=CODOL_GetEffectiveConfigstring(bank,base,index);
+        if(effect_prefix(value)!=effect) continue;
+        if(strlen(value)>=sizeof(rewritten)) goto fail;
+        snprintf(rewritten,sizeof(rewritten),"%03u%s",slot,value+3);
+        if(!CODOL_SetConfigstring(&candidate,index,rewritten)) goto fail;
+    }
+    for(i=0;i<CODOL_NOTETRACK_EFFECT_SLOTS;++i) {
+        unsigned index=CODOL_CS_NOTETRACK_EFFECTS+i;
+        const char *value=CODOL_GetEffectiveConfigstring(bank,base,index);
+        if(notetrack_effect(value,&start,&end)!=effect) continue;
+        if(strlen(value)>=sizeof(rewritten)-3) goto fail;
+        memcpy(rewritten,value,start);
+        snprintf(rewritten+start,sizeof(rewritten)-start,"%u%s",slot,value+end);
+        if(!CODOL_SetConfigstring(&candidate,index,rewritten)) goto fail;
+    }
+    if(!CODOL_ConfigstringPoolSize(&candidate,base,NULL)) goto fail;
+    CODOL_ClearConfigstrings(bank); *bank=candidate; return (int)slot;
+fail:
+    CODOL_ClearConfigstrings(&candidate); return -1;
+}
 
