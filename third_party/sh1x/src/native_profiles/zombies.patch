-            last_offhand[i] = ps->offHandIndex;
-            continue;
-        }
-        if (ps->weapon == last_weapon[i] && ps->offHandIndex == last_offhand[i]) continue;
-        last_weapon[i] = ps->weapon;
-        last_offhand[i] = ps->offHandIndex;
