-            if(!strcmp(stored,text)) { *index=(int)slot; return 1; }
-            continue;
-        }
-        bank=CODOL_ServerConfigstrings();
-        if(!bank || strlen(text)>MAX_STRING_CHARS-32 || strchr(text,'\n') || strchr(text,'\r') ||
-           !CODOL_SetConfigstring(bank,CODOL_CS_HINTSTRINGS+slot,text)) {
