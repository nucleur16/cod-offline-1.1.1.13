-    if(svs.time-last[slot]<250 && svs.time>=last[slot]) return;
-    last[slot]=svs.time;
-    ent=&g_entities[slot];
-    parent=ent->tagInfo ? ent->tagInfo->parent : NULL;
-    ground=ps->groundEntityNum>=0 && ps->groundEntityNum<ENTITYNUM_WORLD ?
-        &g_entities[ps->groundEntityNum] : NULL;
