+void CODOL_PlayerCmd_ViewmodelFXReady(scr_entref_t ref)
+{
+    playerState_t *ps;
+    if(ref.classnum || ref.entnum>=MAX_CLIENTS || !g_entities[ref.entnum].client) {
+        Scr_ObjectError("viewmodel FX readiness requires a player"); return;
+    }
+    if(Scr_GetNumParam()) { Scr_Error("codol_viewmodelFXReady takes no arguments"); return; }
+    ps=&g_entities[ref.entnum].client->ps;
+    Scr_AddBool(g_entities[ref.entnum].health>0 && ps->viewlocked==0 &&
+                (ps->weaponstate==0 || ps->weaponstate==5));
+}
+/* C1's real server builtins 544ff0 and545230, not a world-tag workaround.
+ * Their caller is a player, argc2..3: effect ID, tag, optional right/left.
+ * Both publish the same shared effect/tag compound bank and a recipient-only
+ * temp entity. The stop method identifies the same pair, not a fake handle. */
+static void viewmodel_fx(scr_entref_t ref,int stop)
+{
+    unsigned count=Scr_GetNumParam(),hand=0;
+    int effect,nativeTagged,slot;
+    const char *tag;
+    gentity_t *event,*player;
+    if(ref.classnum || ref.entnum>=MAX_CLIENTS || !g_entities[ref.entnum].client) {
+        Scr_ObjectError("viewmodel FX requires a player"); return;
+    }
+    if(count<2 || count>3) { Scr_Error("Invalid params to ViewModelFXOnTag"); return; }
+    effect=Scr_GetInt(0);tag=Scr_GetString(1);
+    if(count==3) {
+        const char *name=Scr_GetString(2);
+        if(!Q_stricmp(name,"left")) hand=1;
+        else if(Q_stricmp(name,"right")) { Scr_ParamError(2,"Hand must be right or left"); return; }
+    }
+    if(effect<=0 || effect>=CODOL_EFFECT_SLOTS || !tag || !*tag) {
+        Scr_ParamError(0,"invalid effect or tag"); return;
+    }
+    /* The retained native allocator runs SV_SetConfigstring's asset bridge:
+     * this publishes a reliable C1 compound update before the temp event and
+     * also binds effects before the first human gamestate. Directly allocating
+     * only the wire bank would leave connected clients missing that identity. */
+    nativeTagged=CODOL_RegisterNativeTaggedEffect((unsigned)effect,tag);
+    slot=nativeTagged>0 ? CODOL_ServerTaggedEffectToWire((unsigned)nativeTagged) : -1;
+    if(slot<=0) { Scr_Error("viewmodel effect/tag registry exhausted or invalid"); return; }
+    player=&g_entities[ref.entnum];
+    event=G_TempEntity(player->r.currentOrigin,stop ? CODOL_EV_STOP_VIEWMODEL_FX : CODOL_EV_PLAY_VIEWMODEL_FX);
+    event->s.eventParm=slot;
+    event->s.un1.helicopterStage=(int)hand;
+    memset(event->r.clientMask,0xff,sizeof(event->r.clientMask));
+    event->r.clientMask[ref.entnum>>5]&=~(1u<<(ref.entnum&31));
+}
+void CODOL_PlayerCmd_PlayViewModelFXOnTag(scr_entref_t ref) { viewmodel_fx(ref,0); }
+void CODOL_PlayerCmd_StopViewModelFXOnTag(scr_entref_t ref) { viewmodel_fx(ref,1); }
