+/* SPDX-License-Identifier: AGPL-3.0-or-later */
+#ifndef CODOL_DIVE_H
+#define CODOL_DIVE_H
+#include <stdint.h>
+
+/* Server-only provenance on an actual painful landing. C1 owns bits 0..6
+ * (damage percent) and 0x80 (surface); 0x100 never reaches its wire codec.
+ * Keep this on the queued event, since later pmove substeps may end the dive
+ * before HandleClientEvent dispatches its fall-damage callback. */
+#define CODOL_FALL_DIVE_EVENT_MARKER 0x100u
+#define CODOL_DAMAGE_DIVE_LANDING 0x20000000u
+#define CODOL_PMF_DIVETOPRONE 0x40000000u
+
+static inline uint32_t CODOL_DiveLandingEventParameter(uint32_t parameter,
+                                                       uint32_t pm_flags)
+{
+    return parameter | ((pm_flags & CODOL_PMF_DIVETOPRONE)
+                        ? CODOL_FALL_DIVE_EVENT_MARKER : 0u);
+}
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+/* Called only by the native painful-landing dispatch, before its percentage
+ * mask. This is a script damage reason, not a playerState or wire flag. */
+unsigned CODOL_DiveLandingDamageFlags(uint32_t parameter);
+#ifdef __cplusplus
+}
+#endif
+#endif
