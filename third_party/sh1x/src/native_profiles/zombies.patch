diff --git a/zombies/src/codol/weapon/codol_melee_trace.c b/src/codol/weapon/codol_melee_trace.c
new file mode 100644
index 0000000..7bfb559
--- /dev/null
+++ b/src/codol/weapon/codol_melee_trace.c
@@ -0,0 +1,73 @@
+/* C1 player Melee_Trace, 0x573610..0x573a12 (1.1.1.13).
+ * Nine fan rays: centre, half-width/height axes, then full-size corners.
+ * Player origin is backed up 10 units along forward (573669..57369b).
+ * Each ray obeys world occlusion; a character contact wins over scenery
+ * found on an earlier ray (573932..573996). Otherwise retain nearest contact.
+ * Actor swipes retain their existing trace and authored AI dimensions.
+ * SPDX-License-Identifier: AGPL-3.0-or-later */
+#include "q_shared.h"
+#include "entity.h"
+#include "g_shared.h"
+#include "g_public.h"
+#include "cm_public.h"
+#include "codol_weapon_give.h"
+#include <string.h>
+
+extern char bulletPriorityMap[];
+extern void G_CheckHitTriggerDamage(gentity_t *, const float *, const float *, int, int);
+extern void CODOL_GlassMeleeDamage(const trace_t *, const float *, const float *);
+extern void CODOL_MeleeDimensions(gentity_t *, const codol_weaponParms_t *, float *);
+
+/* G_CheckHitTriggerDamage consumes the retained engine's MOD enum (7).
+ * C1's corresponding index is 8; wire/script translation happens elsewhere. */
+#define NATIVE_MOD_MELEE 7
+
+qboolean CODOL_PlayerMeleeTraceC1(gentity_t *attacker, codol_weaponParms_t *wp,
+    int damage, float range, float width, float height, trace_t *result, float *hitpos)
+{
+    static const float offsets[9][2] = {
+        {0,0}, {.5f,0}, {-.5f,0}, {0,.5f}, {0,-.5f},
+        {1,1}, {-1,1}, {1,-1}, {-1,-1}
+    };
+    float dimensions[3] = {range,width,height};
+    vec3_t start,end,point;
+    trace_t trace;
+    int i,j,count;
+    CODOL_MeleeDimensions(attacker,wp,dimensions);
+    range=dimensions[0]; width=dimensions[1]; height=dimensions[2];
+    memset(result,0,sizeof(*result));
+    result->fraction=1.0f;
+    result->hitId=ENTITYNUM_NONE;
+    for(j=0;j<3;++j) hitpos[j]=wp->muzzleTrace[j]+range*wp->forward[j];
+    count=width>0.0f || height>0.0f ? 9 : 1;
+    for(j=0;j<3;++j) start[j]=wp->muzzleTrace[j]-10.0f*wp->forward[j];
+    for(i=0;i<count;++i) {
+        for(j=0;j<3;++j)
+            end[j]=wp->muzzleTrace[j]+range*wp->forward[j]+
+                offsets[i][0]*width*wp->right[j]+offsets[i][1]*height*wp->up[j];
+        /* C1 5737b0 uses 0x280e091; this is a locational character trace. */
+        G_LocationalTrace(&trace,start,end,attacker->s.number,0x280e091,bulletPriorityMap);
+        for(j=0;j<3;++j) point[j]=start[j]+trace.fraction*(end[j]-start[j]);
+        if(!i) {
+            CODOL_GlassMeleeDamage(&trace,point,wp->forward);
+            G_CheckHitTriggerDamage(attacker,start,point,damage,NATIVE_MOD_MELEE);
+        }
+        if(trace.fraction>=1.0f || (trace.sflags & 0x10)) continue;
+        if(trace.hitType==TRACE_HITTYPE_ENTITY && trace.hitId<ENTITYNUM_WORLD) {
+            gentity_t *target=&g_entities[trace.hitId];
+            if(target->r.inuse && (target->client || target->s.eType==ET_ACTOR)) {
+                /* C1 573948..573958: the last four rays do not catch a
+                 * client carrying this stance flag; actor limbs still do. */
+                if(target->client && i>4 && (target->client->ps.pm_flags & 0x100)) continue;
+                *result=trace;
+                memcpy(hitpos,point,sizeof(point));
+                return qtrue;
+            }
+        }
+        if(trace.fraction<result->fraction) {
+            *result=trace;
+            memcpy(hitpos,point,sizeof(point));
+        }
+    }
+    return result->fraction<1.0f;
+}
