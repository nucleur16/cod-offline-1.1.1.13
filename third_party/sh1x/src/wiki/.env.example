# Copy to wiki/.env and adjust. docker compose reads this file too.
POSTGRES_USER=wiki
POSTGRES_PASSWORD=wiki
POSTGRES_DB=sh1x_wiki
POSTGRES_PORT=5433
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Signs session tokens. Generate one: python -c "import secrets;print(secrets.token_urlsafe(48))"
WIKI_SECRET_KEY=change-me-in-.env-before-exposing-this-wiki

# Used when running the backend outside docker (host -> published db port).
WIKI_DATABASE_URL=postgresql+asyncpg://wiki:wiki@localhost:5433/sh1x_wiki
WIKI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: password for the admin account created by `app.cli admin`.
# Leave empty to be prompted, or to have one generated and printed.
WIKI_ADMIN_PASSWORD=
