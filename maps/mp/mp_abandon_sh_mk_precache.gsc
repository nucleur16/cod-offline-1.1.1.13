// PROVENANCE (2026-10-14): CoDOL mp_abandon_sh_mk. Same role as IW4
// maps/mp/mp_abandon_precache.gsc (the autogenerated per-map precache list the
// level script calls before _load): one call per destructible anim module and
// per animated_models script the map's entities name. The animated_models
// names are the entities' own precache_script keys.
main()
{
	common_scripts\_destructible_types_anim_firecracker::main();
	maps\animated_models\mp_abandon_banner_idle::main();
	maps\animated_models\mp_abandon_dragon_windsock_idle::main();
	maps\animated_models\mp_abandon_ferris_wheel::main();
	maps\animated_models\mp_abandon_sh_mk_badguys::main();
	maps\animated_models\mp_abandon_sh_mk_globe::main();
	maps\animated_models\mp_abandon_sh_mk_moat_fish::main();
	maps\animated_models\mp_abandon_sh_mk_ufo1::main();
	maps\animated_models\mp_abandon_sh_mk_ufo2::main();
}
