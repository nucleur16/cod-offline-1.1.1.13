/*
	scripts/codol/character/character_mp_german_shepherd.gsc

	Adapted from the shipped Black Ops (T5) script source:
		D:\CoD\COD-GSC-Source\T5-STEAM-GSC\character\character_mp_german_shepherd.gsc
	(T5 marks it autogenerated.)

	Changed for CoDOL:
	  - the literal model "german_shepherd" is replaced by
	    maps\mp\_dogs::dog_model_friendly().  "german_shepherd" is NOT in the
	    C1 client zones; the only dog model the client ships is
	    "german_sheperd_dog" (obj/dog-asset-string-inventory.json).  Routing
	    through maps\mp\_dogs keeps the name in one place - the same accessor
	    feeds level.friendlyDogModel / level.enemyDogModel in _dogs::init.
	  - character_mp_german_shepherd_black is deliberately NOT ported: C1 ships
	    no black shepherd model, and maps\mp\_dogs::dog_model_enemy() returns
	    the same model as the friendly one.
	  - self.voice / self.skeleton are unchanged.
*/

// THIS FILE IS AUTOGENERATED, DO NOT MODIFY
main()
{
	self setModel( maps\mp\_dogs::dog_model_friendly() );
	self.voice = "american";
	self.skeleton = "base";
}

precache()
{
	precacheModel( maps\mp\_dogs::dog_model_friendly() );
}
