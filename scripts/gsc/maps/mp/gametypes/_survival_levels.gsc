// maps/mp/gametypes/_survival_levels -- which levels have survival data.
//
// GENERATED by tools/codol_survival_ents.py (one case per maps/mp/survival/<level>.gsc).

has_data( mapname )
{
	switch ( mapname )
	{
	case "mp_abandon_sh":
	case "mp_ambush_sh":
	case "mp_crash_tropical":
	case "mp_cross_fire":
	case "mp_fav_tropical":
	case "mp_firingrange":
	case "mp_hardhat_sh":
	case "mp_highrise":
	case "mp_qadeem_sh":
	case "mp_seatown":
	case "mp_storm_spring":
	case "mp_strike_sh":
	case "mp_subbase_sh":
	case "mp_terminal_cls":
		return true;
	}
	return false;
}

