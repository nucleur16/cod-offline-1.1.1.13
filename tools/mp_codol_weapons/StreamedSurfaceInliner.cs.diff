+using System.Buffers.Binary;
+using Codol.Assets.Assets;
+using Codol.Assets.Game;
+using Codol.Assets.Models;
+using Codol.FastFiles.Iwd;
+using Codol.FastFiles.Porting;
+
+namespace Codol.Assets.Porting;
+
+/// Puts the geometry of streamed XModelSurfs into the zone image. A streamed XModelSurfs (surfs NULL, numsurfs 0 in
+/// the zone) is completed at run time from models/<name> in the IWDs (StreamedSurfaceLoader). The target build only
+/// has the files it shipped, and the sh1x server builds model collision from the zone alone ("mesh -1" for such a
+/// model fails the map when it is a static or dynamic world model), so the ported zone carries the surfaces inline,
+/// as stock zones do for every model they do not stream.
+public static class StreamedSurfaceInliner
+{
+    private const int XModelSurfsType = 3;
+
+    /// image addresses no capture uses: blocks are (b+1)<<28 for b < 8, the pool 0x90010000, the writer 0xC0000000
+    private const uint MappedBase = 0xB0000000;
+
+    /// inlines every streamed XModelSurfs of `image` whose file the archives hold; returns how many
+    public static int Inline(ZoneImage image, IwdArchiveSet? archives, List<string> warnings) => Inline(image, archives, warnings, null);
+
+    /// as Inline, only for the XModelSurfs whose name `filter` accepts (null: all)
+    public static int Inline(ZoneImage image, IwdArchiveSet? archives, List<string> warnings, Func<string, bool>? filter)
+    {
+        var streamed = image.AssetHeaders.Where(h => h.Value == XModelSurfsType)
+            .Select(h => h.Key)
+            .Where(h => image.Memory.U32(h + XModelSurfsLayout.Surfs) == 0 && image.Memory.U16(h + XModelSurfsLayout.NumSurfs) == 0)
+            .ToList();
+        if (streamed.Count == 0)
+        {
+            return 0;
+        }
+        if (archives is null)
+        {
+            warnings.Add($"{streamed.Count} model surface sets are streamed but the source build has no model IWDs; they stay streamed");
+            return 0;
+        }
+        uint top = MappedBase;
+        int inlined = 0;
+        foreach (uint header in streamed)
+        {
+            string? name = image.Memory.U32(header + XModelSurfsLayout.Name) is var p && p != 0 ? image.Memory.CString(p, 256) : null;
+            if (name is null || name.StartsWith(',') || (filter is not null && !filter(name)))
+            {
+                continue;
+            }
+            string path = "models/" + name;
+            if (!archives.TryGetEntry(path, out var archive, out var entry))
+            {
+                warnings.Add($"streamed surfaces {path} are in no source IWD; the model stays streamed");
+                continue;
+            }
+            try
+            {
+                uint mapped = Map(image, path, archive.Read(entry), ref top);
+                var m = image.Memory;
+                uint surfaces = m.U32(mapped + XModelSurfsLayout.Surfs);
+                m.WU16(header + XModelSurfsLayout.NumSurfs, m.U16(mapped + XModelSurfsLayout.NumSurfs));
+                for (uint o = XModelSurfsLayout.PartBits; o < XModelSurfsLayout.Size; o += 4)
+                {
+                    m.WU32(header + o, m.U32(mapped + o));
+                }
+                image.SetPointer(header + XModelSurfsLayout.Surfs, surfaces, PointerEncoding.Inline);
+                inlined++;
+            }
+            catch (AssetFormatException ex)
+            {
+                warnings.Add($"streamed surfaces {path}: {ex.Message}; the model stays streamed");
+            }
+        }
+        return inlined;
+    }
+
+    /// maps the file's three data blocks into the image and records its fixups as pointer fields and the ranges they
+    /// lead to as objects (each object runs to the next pointer target in its block); returns block 0's address
+    private static uint Map(ZoneImage image, string name, byte[] file, ref uint top)
+    {
+        var header = StreamedSurfaceLoader.ParseHeader(name, file);
+        var blocks = header.Blocks;
+        uint[] bases = new uint[3];
+        foreach (int b in (int[])[0, 2, 1])
+        {
+            top = (top + 15) & ~15u;
+            bases[b] = top;
+            top += Math.Max(blocks[b].Size, 4) + 16;
+            image.Memory.Write(bases[b], file.AsSpan((int)blocks[b].FileOffset, (int)blocks[b].Size));
+        }
+        var fixups = file.AsSpan((int)blocks[3].FileOffset, (int)blocks[3].Size);
+        var fields = new List<uint>();
+        var starts = new SortedSet<uint>[3] { [bases[0]], [], [] };
+        for (int b = 0; b < 3; b++)
+        {
+            var d = blocks[b];
+            if ((long)d.FixupStart + d.FixupCount > fixups.Length / 4)
+            {
+                throw new AssetFormatException(name, $"block {b} fixups {d.FixupStart}+{d.FixupCount} exceed the table");
+            }
+            for (uint k = d.FixupStart; k < d.FixupStart + d.FixupCount; k++)
+            {
+                int fixup = BinaryPrimitives.ReadInt32LittleEndian(fixups[(int)(4 * k)..]);
+                int target = (fixup << 29) >> 29;
+                int offset = fixup >> 3;
+                if (target is < 0 or > 2 || offset < 0 || (long)offset + 4 > d.Size)
+                {
+                    throw new AssetFormatException(name, $"fixup {k} (0x{fixup:X8}) of block {b} is out of range");
+                }
+                uint field = bases[b] + (uint)offset;
+                uint value = image.Memory.U32(field) + bases[target];
+                image.Memory.WU32(field, value);
+                fields.Add(field);
+                starts[target].Add(value);
+            }
+        }
+        for (int b = 0; b < 3; b++)
+        {
+            uint end = bases[b] + blocks[b].Size;
+            var list = starts[b].Where(s => s < end).ToList();
+            for (int i = 0; i < list.Count; i++)
+            {
+                uint next = i + 1 < list.Count ? list[i + 1] : end;
+                image.Objects[list[i]] = Math.Max(next - list[i], 1);
+            }
+        }
+        foreach (uint field in fields)
+        {
+            image.SetPointer(field, image.Memory.U32(field), PointerEncoding.Inline);
+        }
+        return bases[0];
+    }
+}
