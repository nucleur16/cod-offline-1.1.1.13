        Log("minigun pair: invalid native template/helper, not installed"); return FALSE;
    }
    memcpy(&sentinel, kPairTemplate333 + 177, sizeof(sentinel));
    if (sentinel != 0xFEE1DEADu) {
        Log("minigun pair: unresolved-template contract differs, not installed"); return FALSE;
