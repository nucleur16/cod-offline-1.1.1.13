        Log("minigun pair: native context differs, not installed"); return FALSE;
    }
    if (!Readable((const void *)(DWORD_PTR)0x00738C40u, sizeof(kPairGuard_single_alias_forward)) ||
        memcmp((const void *)(DWORD_PTR)0x00738C40u, kPairGuard_single_alias_forward, sizeof(kPairGuard_single_alias_forward))) {
        Log("minigun pair: native context differs, not installed"); return FALSE;
