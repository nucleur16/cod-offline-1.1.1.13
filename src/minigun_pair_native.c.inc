    if (!Readable((const void *)(DWORD_PTR)0x0073DF10u, sizeof(kPairGuard_native_stream_stop)) ||
        memcmp((const void *)(DWORD_PTR)0x0073DF10u, kPairGuard_native_stream_stop, sizeof(kPairGuard_native_stream_stop))) {
