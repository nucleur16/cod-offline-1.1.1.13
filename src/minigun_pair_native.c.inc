{
    BYTE replacement[343];
    BYTE *site = (BYTE *)(DWORD_PTR)0x00737D00u;
    DWORD helper = (DWORD)(DWORD_PTR)&SndRestricted2DCleanup;
    DWORD sentinel = 0;
    if (sizeof(kPairOriginal343) != 343 || sizeof(kPairTemplate333) != 333 ||
        177 + sizeof(helper) > sizeof(kPairTemplate333) || kPairTemplate333[176] != 0xB8 ||
