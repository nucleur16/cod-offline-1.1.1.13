    if (!Readable((const void *)(DWORD_PTR)0x007378ADu, sizeof(kPairGuard_voice_alias_fields)) ||
        memcmp((const void *)(DWORD_PTR)0x007378ADu, kPairGuard_voice_alias_fields, sizeof(kPairGuard_voice_alias_fields))) {
        Log("minigun pair: native context differs, not installed"); return FALSE;
    }
    if (!Readable((const void *)(DWORD_PTR)0x0073DEA0u, sizeof(kPairGuard_native_3D_stop)) ||
        memcmp((const void *)(DWORD_PTR)0x0073DEA0u, kPairGuard_native_3D_stop, sizeof(kPairGuard_native_3D_stop))) {
        Log("minigun pair: native context differs, not installed"); return FALSE;
