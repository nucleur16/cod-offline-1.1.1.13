@@ -546,6 +553,27 @@
 }
 
 
+/*
+	CoDOL: "classN" from a human names the profile's loadout N ("custom<N+1>"),
+	never a column of the stock class table. Bots keep their own class path, and
+	the fixed-loadout modes never get here (menuClass returns before).
+*/
+codolProfileClass( response )
+{
+	if ( isDefined( self.pers["isBot"] ) || ( isDefined( self.codolCombatBot ) && self.codolCombatBot ) )
+		return response;
+	if ( isDefined( self.isbot ) && self.isbot )
+		return response;
+	if ( getSubStr( response, 0, 5 ) != "class" )
+		return response;
+	index = int( getSubStr( response, 5 ) );
+	if ( response != "class" + index )
+		return response;
+	if ( !maps\mp\gametypes\_class::codol_hasLoadoutClass( index ) )
+		return response;
+	return "custom" + ( index + 1 );
+}
