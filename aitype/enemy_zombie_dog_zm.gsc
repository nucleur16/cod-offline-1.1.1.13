// zm hellhound aitype.
//
// The zm counterpart of aitype/enemy_dog_mp.gsc (T5's autogenerated
// aitype\enemy_dog_mp.gsc), loaded as aitype/<classname without actor_> by
// CODOL_ActorScriptsLoadType for the "zombie_dog" species row
// (src/codol/player/codol_actor_scripts.cpp).  Only the zm species preload
// names it, so a multiplayer match never compiles it.
//
// MEASURED (docs/zone_assets): the hellhound body "zombie_wolf" ships in all
// three zm MAP zones, and the maps' own authored actor_zombie_dog spawners
// name it ("model" "zombie_wolf"); the bite WeaponDef "dog_bite_zm" ships in
// the same three zones.  T5 enemy_zombie_dog: health 200 (the round code sets
// the real value, _zombiemode_ai_dogs::dog_health_increase), team axis.

/*QUAKED actor_enemy_zombie_dog_zm (1.0 0.25 0.0) (-16 -16 0) (16 16 72) SPAWNER MAKEROOM UNDELETABLE ENEMYINFO SCRIPT_FORCESPAWN SM_PRIORITY
defaultmdl="zombie_wolf"
"count" -- max AI to ever spawn from this spawner
SPAWNER -- makes this a spawner instead of a guy
MAKEROOM -- will try to delete an AI if spawning fails from too many AI
UNDELETABLE -- this AI (or AI spawned from here) cannot be deleted to make room for MAKEROOM guys
ENEMYINFO -- this AI when spawned will get a snapshot of perfect info about all enemies
SCRIPT_FORCESPAWN -- this AI will spawned even if players can see him spawning.
SM_PRIORITY -- Make the Spawn Manager spawn from this spawner before other spawners.
*/
main()
{
	self.animTree = "zombie_dog.atr";
	self.team = "axis";
	self.type = "zombie_dog";
	self.accuracy = 1;
	self.health = 200;
	self.weapon = character\character_zm_zombie_dog::bite_weapon();
	self.secondaryweapon = "";
	self.sidearm = "";
	self.grenadeWeapon = "";
	self.grenadeAmmo = 0;
	self.csvInclude = "";

	self setEngagementMinDist( 0.000000, 0.000000 );
	self setEngagementMaxDist( 100.000000, 300.000000 );

	character\character_zm_zombie_dog::main();
}

spawner()
{
	self setspawnerteam( "axis" );
}

precache()
{
	character\character_zm_zombie_dog::precache();
}
